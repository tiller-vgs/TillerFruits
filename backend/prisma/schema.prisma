generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
  admin
}

enum FileStatus {
  new
  sent
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(student)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  files           File[]
  assignments     Assignment[]
  accounts        Account[]
  sessions        Session[]
  assignmentUsers AssignmentUser[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model File {
  id Int @id @default(autoincrement())

  creatorId   String
  displayName String @unique

  originalName String
  savedName    String

  mimeType  String
  extension String
  fileSize  Int
  filehash  String

  status    FileStatus @default(new)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  creator   User       @relation(fields: [creatorId], references: [id])

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

// TEACHER'S ASSIGNMENT
model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())

  questions Question[]
  files     File[]
  users     AssignmentUser[]
  user      User?            @relation(fields: [userId], references: [id])
  userId    String?

  @@map("assignment")
}

model Question {
  id           Int    @id @default(autoincrement())
  title        String
  assignmentId Int

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model AssignmentUser {
  assignmentId Int
  userId       String
  anonDisplayName String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
}
